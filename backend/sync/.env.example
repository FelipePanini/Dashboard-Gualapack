# Copie este arquivo para ".env" para testar localmente e preencha os valores
# reais. NUNCA commite o ".env" de verdade no git (já está no .gitignore).

# Supabase — Project Settings > API
SUPABASE_URL=https://iwocigbdywkypvagrrjk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Entra ID (Azure AD) — app registrado com permissão Sites.Read.All
# (application, não delegada). Ver backend/sync/README.md passo 3.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Site do SharePoint no formato "hostname:/caminho", ex:
# gualapackspa.sharepoint.com:/personal/felipe_panini_gualapack_com
SHAREPOINT_SITE=
# Caminho da pasta dentro da biblioteca de documentos do site acima, ex:
# "Documentos Compartilhados/Painel Produção" (sem barra no início)
SHAREPOINT_FOLDER_PATH=
