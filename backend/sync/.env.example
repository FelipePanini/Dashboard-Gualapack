# Copie este arquivo para ".env" no servidor e preencha os valores reais.
# NUNCA commite o ".env" de verdade no git (já está no .gitignore do projeto).

# Supabase — Project Settings > API
SUPABASE_URL=https://iwocigbdywkypvagrrjk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive — pasta única com os exports dos BIs + planilhas manuais
SYNC_DRIVE_FOLDER_ID=

# Conta de serviço do Google — use UMA das duas opções:
# (a) rodando local: caminho para o arquivo JSON baixado do Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# (b) rodando no GitHub Actions: o conteúdo do JSON inteiro, colado num Secret
#     do repositório (ver backend/sync/README.md)
GOOGLE_SERVICE_ACCOUNT_JSON=
